# Copy this file to .env and adjust if needed.
# These database credentials are the local-only ones from docker-compose.yml.

# Postgres from docker-compose.yml (laptop port 5433)
DATABASE_URL="postgresql://miniledger:miniledger@localhost:5433/miniledger"

# 0.0.0.0 = listen on every network interface, so a phone on the same Wi-Fi can reach the API
HOST=0.0.0.0
PORT=3000

# Secrets: at least 32 characters. Generate real ones with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
OTP_SECRET=replace-with-a-different-random-string-of-32-plus-chars
