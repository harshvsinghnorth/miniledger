# Copy this file to .env and adjust if needed.
# These database credentials are the local-only ones from docker-compose.yml.

# Postgres from docker-compose.yml (laptop port 5433)
DATABASE_URL="postgresql://miniledger:miniledger@localhost:5433/miniledger"

# 0.0.0.0 = listen on every network interface, so a phone on the same Wi-Fi can reach the API
HOST=0.0.0.0
PORT=3000
