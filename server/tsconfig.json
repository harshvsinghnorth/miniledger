{
  // Used by the editor and `npm run typecheck`: checks the app, the tests and the configs.
  // The build (compiling src/ into dist/) uses tsconfig.build.json.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src", "tests", "vitest.config.ts", "prisma.config.ts"]
}
